# Local Supabase stack — used ONLY by the Playwright suite.
# The app itself reads .env.local, which points at the hosted project.
# Keys below are the Supabase CLI's fixed local-development defaults, not secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DEV_USER_PASSWORD=
