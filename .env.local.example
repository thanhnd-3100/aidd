# Supabase project connection (see supabase/config.toml)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth provider credentials for Supabase auth.external.google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Home screen countdown target (server-only, do not prefix NEXT_PUBLIC_)
EVENT_DATETIME=2025-12-31T18:30:00+07:00

# Prelaunch gate toggle (server-only, read by middleware.ts). Defaults to
# "off" when unset/empty — never make an empty value fail the build, unlike
# the Supabase vars above.
PRELAUNCH_GATE_ENABLED=false
