# Supabase project connection (see supabase/config.toml)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local-dev-only: service role key for `scripts/seed-auth-users.ts` (admin API) and the
# Postgres connection string for `npm run db:reset:dev`. Never set these against a hosted
# project; local Supabase only. Get them from `supabase status` after `supabase start`.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Dev-only password given to the seeded auth users by `scripts/seed-auth-users.ts`.
# Falls back to a fixed placeholder value if unset. Never a real credential.
SUPABASE_DEV_USER_PASSWORD=

# Google OAuth provider credentials for Supabase auth.external.google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Home screen countdown target (server-only, do not prefix NEXT_PUBLIC_)
EVENT_DATETIME=2025-12-31T18:30:00+07:00

# Prelaunch gate toggle (server-only, read by middleware.ts). Defaults to
# "off" when unset/empty — never make an empty value fail the build, unlike
# the Supabase vars above.
PRELAUNCH_GATE_ENABLED=false
